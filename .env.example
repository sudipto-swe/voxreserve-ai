# VOXRESERVE Environment Variables

PROJECT_NAME=VOXRESERVE
ENVIRONMENT=development

# Database: SQLite for local out-of-the-box zero-setup; or PostgreSQL for multi-worker container deployments
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voxreserve
DATABASE_URL=sqlite:///./voxreserve.db

# JWT Security
SECRET_KEY=voxreserve-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Restaurant Configuration
RESTAURANT_TIMEZONE=America/Los_Angeles
RESERVATION_SLOT_MINUTES=90
RESERVATION_BUFFER_MINUTES=15

# Ollama / Local AI Model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
MOCK_LLM_IF_UNAVAILABLE=true

# Optional STT/TTS Providers
WHISPER_CPP_URL=
PIPER_TTS_URL=
